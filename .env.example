# Copy to .env and set real passwords:  cp .env.example .env
# .env is gitignored. Docker Compose, Django and the scrapers all read their settings from it.

# --- Elasticsearch / Kibana ---
ES_VERSION=8.19.0
ES_URL=http://localhost:9200
ES_PORT=9200
KIBANA_PORT=5601
# Production only (ES 8 with security on). Leave empty locally.
#   ES_URL=https://localhost:9200
#   ES_PASSWORD=<elastic user's password>
#   ES_CA_CERTS=/home/deploy/scrapesearch/http_ca.crt
ES_USERNAME=elastic
ES_PASSWORD=
ES_CA_CERTS=

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=scrapesearch
MYSQL_USER=scrapesearch
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# --- Django ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# (Avoid "$" in any value here: docker compose would treat "$abc" as a variable reference.)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production:
#   DJANGO_DEBUG=0
#   DJANGO_ALLOWED_HOSTS=example.com,www.example.com
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
#   DJANGO_HTTPS=1          (after certbot)
#   DJANGO_HSTS_SECONDS=3600  (after HTTPS works; raise to 31536000 later)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=0
DJANGO_HSTS_SECONDS=0
